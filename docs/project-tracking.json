  "milestones": {
    "F": {
      "id": "af961383-dcd3-437f-ac67-f8938c14a35f",
      "name": "01 Foundation and feasibility",
      "description": "F0–F5: workload/acceptance contract, build and fault harness, PG/Temporal/Restate experiments, native format/local I/O, bounded SQL compatibility/isolation and cache evaluation contract, Git/reuse baseline and accepted architecture decisions or explicit deferrals.",
      "progress": 0,
      "sortOrder": 99
    },
    "M": {
      "id": "539c9cc2-c7e6-4c32-8d02-c84177f289de",
      "name": "02 Small-team MVP",
      "description": "M1–M8: durable storage and domain/read APIs; sparse CLI and web review; CI/landing; Git migration; permissions; install/upgrade/restore; release evidence. Private alpha is M1–M4 plus the minimum M7 recovery subset; HA is separately qualified.",
      "progress": 0,
      "sortOrder": 1006
    },
    "S": {
      "id": "57cc9eb4-f569-4999-8f56-d06b2987b47e",
      "name": "03 Large-organization qualification",
      "description": "S1–S8: explicit HA/durability, API/worker scale, optional Dragonfly/Valkey cache qualification and enterprise governance; workload-triggered distributed SQL comparison/migration, many-repo/hot-monorepo scaling, DR and advertised-capability release evidence.",
      "progress": 0,
      "sortOrder": 1991
    }
  },
